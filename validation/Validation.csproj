<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <SyslogSource Condition="'$(SyslogSource)' == ''">../src/SyslogDecode</SyslogSource>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(SyslogSource)/**/*.cs" Exclude="$(SyslogSource)/obj/**;$(SyslogSource)/bin/**" />
  </ItemGroup>
</Project>
